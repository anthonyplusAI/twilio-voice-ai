# Optional: your upgraded Twilio account, only for calling through this Codespace's /call route.
# The workshop site's Call Me button uses the site's Twilio account instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Required for your Builder agent to answer calls. Add your own key or one supplied by the facilitator.
OPENAI_API_KEY=

# OpenAI model
OPENAI_MODEL=gpt-5.4-nano

# Your phone in E.164 format, only for calling through this Codespace's /call route.
MY_PHONE_NUMBER=

# Optional: a second reachable E.164 number, different from the caller, for live handoff.
HANDOFF_PHONE_NUMBER=

# Server port (default: 8080)
PORT=8080
