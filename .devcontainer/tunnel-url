#!/usr/bin/env bash
set -euo pipefail

ROUTE="${1:-twiml}"
if [[ $# -gt 1 || "$ROUTE" != "twiml" ]]; then
  echo "Usage: tunnel-url [twiml]" >&2
  exit 2
fi

# setup.sh links this command to the checkout, so it can recover a stopped
# tunnel or find a URL that cloudflared printed after the initial wait.
SOURCE_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
exec bash "$SCRIPT_DIR/start-tunnel.sh" --url "$ROUTE"
